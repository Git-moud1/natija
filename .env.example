# ── Natija environment variables ────────────────────────────────────────────


# Choose a long, random value. The login is checked server-side only.
ADMIN_PASSWORD=change-me-to-a-long-random-string

# Vercel Blob storage token (required in production).
# Get it from: Vercel Dashboard → Storage → Blob → ".env.local" tab.
# If this is ABSENT, Natija runs in LOCAL mode and stores datasets in ./.data
# so you can develop and test entirely offline.
BLOB_READ_WRITE_TOKEN=
